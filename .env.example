# Robinhood credentials - never commit the real .env file
ROBINHOOD_USERNAME=your_email@example.com
ROBINHOOD_PASSWORD=your_password
# Optional: base32 TOTP secret if you have 2FA app-based authentication enabled
ROBINHOOD_TOTP_SECRET=

# Set to "YES" only when you intend to place real live orders.
# Anything else keeps the agent in dry-run (signals/logging only).
CONFIRM_LIVE_TRADING=NO
